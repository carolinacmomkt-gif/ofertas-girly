# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca use prefixo NEXT_PUBLIC_ aqui.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site (sem barra no final). Usado no Open Graph e no botão "copiar link".
NEXT_PUBLIC_SITE_URL=https://my-girlystyle.netlify.app

# Segredo da rotina de preços (o Netlify usa para chamar /api/cron/precos). Gere com: openssl rand -hex 32
CRON_SECRET=

# Mercado Livre (opcional, mas recomendado). developers.mercadolivre.com.br > Minhas aplicações
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Alternativa: um token de acesso já gerado (expira em 6 h)
ML_ACCESS_TOKEN=

# Opcional: tempo (ms) de cada rodada da atualização de preços. Padrão 8000.
# PRECOS_ORCAMENTO_MS=8000
